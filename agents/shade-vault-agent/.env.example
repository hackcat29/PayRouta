# The PayRouta agent vault this agent pays from (a TEE-mode vault).
AGENT_CONTRACT_ID=payrouta-tee-vault.testnet
NEAR_NETWORK=testnet
# A funded NEAR account that pays the agent account's gas (from `shade auth`).
SPONSOR_ACCOUNT_ID=
SPONSOR_PRIVATE_KEY=
# PayRouta: where checkouts are opened and paid (the agent API).
PAYROUTA_URL=https://payrouta.com
# The EVM network the vault pays on, and its RPC.
EVM_RPC_URL=https://sepolia.base.org
