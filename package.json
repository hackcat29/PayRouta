{
  "name": "payrouta",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "prisma generate && next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "portal:env": "node scripts/local-env.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx scripts/seed.ts",
    "portal:worker": "tsx scripts/worker.ts",
    "portal:worker:once": "tsx scripts/worker.ts --once",
    "portal:code": "tsx scripts/dev-code.ts",
    "portal:db": "node scripts/local-db.mjs",
    "test:portal": "playwright test --config playwright.portal.config.ts",
    "payments:seed": "tsx scripts/payment-fixtures.ts",
    "payments:receiver": "tsx scripts/payment-receiver.ts",
    "test:payments": "tsx --test tests/payments/database.test.ts",
    "test:checkout": "playwright test --config playwright.payments.config.ts",
    "test:merchant": "tsx --test tests/merchant/database.test.ts",
    "test:merchant-browser": "playwright test --config playwright.merchant.config.ts",
    "sdk:build": "npm run build --prefix sdks/node",
    "test:sdk-python": "PYTHONPATH=sdks/python python3 -m unittest discover -s sdks/python/tests",
    "pilot:preflight": "tsx scripts/pilot-preflight.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1134.0",
    "@aws-sdk/s3-request-presigner": "^3.1134.0",
    "@fontsource/inter": "latest",
    "@hookform/resolvers": "^5.9.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "better-auth": "^1.7.5",
    "ipaddr.js": "^2.5.0",
    "lucide-react": "latest",
    "next": "latest",
    "pg": "^8.23.0",
    "react": "latest",
    "react-dom": "latest",
    "react-hook-form": "^7.88.0",
    "react-markdown": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@axe-core/playwright": "latest",
    "@playwright/test": "latest",
    "@tailwindcss/postcss": "latest",
    "@types/node": "latest",
    "@types/pg": "^8.23.1",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "eslint-config-next": "latest",
    "prettier": "^3.9.6",
    "prisma": "^7.10.0",
    "sharp": "^0.35.4",
    "tailwindcss": "latest",
    "tsx": "latest",
    "typescript": "latest"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0",
    "mysql2": "^3.24.0"
  }
}
