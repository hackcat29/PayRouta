{
  "name": "payrouta",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "prisma generate && next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "portal:env": "node scripts/local-env.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx scripts/seed.ts",
    "portal:worker": "tsx scripts/worker.ts",
    "portal:worker:once": "tsx scripts/worker.ts --once",
    "logos:warm": "tsx scripts/warm-logos.ts",
    "portal:code": "tsx scripts/dev-code.ts",
    "portal:db": "node scripts/local-db.mjs",
    "test:portal": "playwright test --config playwright.portal.config.ts",
    "payments:seed": "tsx scripts/payment-fixtures.ts",
    "payments:receiver": "tsx scripts/payment-receiver.ts",
    "test:payments": "tsx --test tests/payments/database.test.ts",
    "test:checkout": "playwright test --config playwright.payments.config.ts",
    "test:merchant": "tsx --test tests/merchant/database.test.ts",
    "test:merchant-browser": "playwright test --config playwright.merchant.config.ts",
    "test:partners": "tsx --test tests/partners/database.test.ts",
    "test:intents": "tsx --test tests/intents/database.test.ts",
    "test:agents": "tsx --test tests/agents/database.test.ts",
    "test:treasury": "tsx --test --test-concurrency=1 tests/treasury/database.test.ts tests/treasury/launch.test.ts tests/treasury/credit.test.ts tests/treasury/universal.test.ts tests/treasury/shopify.test.ts tests/treasury/shopify-lite.test.ts tests/treasury/cashout.test.ts tests/treasury/payment-links.test.ts tests/treasury/subscriptions.test.ts",
    "treasury:sandbox": "tsx scripts/treasury-sandbox.ts",
    "sdk:build": "npm run build --prefix sdks/node",
    "docs:openapi": "tsx scripts/mintlify-openapi.ts",
    "docs:dev": "cd mintlify && npx mint@4.2.1133 dev",
    "test:sdk-python": "PYTHONPATH=sdks/python python3 -m unittest discover -s sdks/python/tests",
    "pilot:preflight": "tsx scripts/pilot-preflight.ts",
    "preflight:production": "tsx scripts/preflight-production.ts",
    "resend:setup": "tsx scripts/resend-setup.ts",
    "secrets:rotate": "tsx scripts/rotate-secrets.ts",
    "secrets:put": "tsx scripts/put-secret.ts",
    "sandbox:providers": "tsx scripts/sandbox-providers.ts",
    "billing:close": "tsx scripts/close-billing.ts",
    "test:stablecoins": "tsx --test tests/stablecoins/database.test.ts",
    "stablecoins:testnet": "tsx scripts/stablecoin-testnet.ts",
    "stablecoins:inspect": "tsx scripts/stablecoin-rpc-check.ts",
    "multichain:preflight": "tsx scripts/multichain-preflight.ts",
    "test:multichain": "tsx --test tests/multichain.test.ts tests/stablecoins/multichain.test.ts",
    "multichain:testnet": "tsx scripts/multichain-testnet.ts",
    "woocommerce:zip": "mkdir -p public/downloads && rm -f public/downloads/payrouta-checkout.zip && cd integrations/woocommerce && zip -qrX ../../public/downloads/payrouta-checkout.zip payrouta-checkout -x \"*.DS_Store\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1134.0",
    "@aws-sdk/s3-request-presigner": "^3.1134.0",
    "@better-auth/passkey": "1.7.5",
    "@better-auth/sso": "1.7.5",
    "@fontsource/inter": "latest",
    "@hookform/resolvers": "^5.9.1",
    "@hot-labs/near-connect": "0.11.4",
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^2.4.0",
    "@phosphor-icons/react": "^2.1.10",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@privy-io/react-auth": "^3.51.3",
    "@radix-ui/react-dialog": "^1.1.23",
    "@react-three/fiber": "^9.8.2",
    "@solana-program/memo": "^0.10.0",
    "@solana-program/system": "^0.10.0",
    "@solana-program/token": "^0.9.0",
    "@solana/kit": "^5.5.1",
    "@solana/web3.js": "^1.99.0",
    "@stellar/freighter-api": "^6.0.1",
    "@stellar/stellar-sdk": "^17.2.1",
    "better-auth": "^1.7.5",
    "bs58": "^6.0.0",
    "country-flag-icons": "^1.6.20",
    "dotenv": "^17.4.2",
    "ipaddr.js": "^2.5.0",
    "lucide-react": "latest",
    "next": "^16.4.3",
    "nodemailer": "^10.0.12",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "react": "latest",
    "react-dom": "latest",
    "react-hook-form": "^7.88.0",
    "react-markdown": "latest",
    "remark-gfm": "^4.0.1",
    "resend": "^6.32.1",
    "three": "^0.187.0",
    "typegpu": "^0.12.10",
    "zod": "latest"
  },
  "devDependencies": {
    "@axe-core/playwright": "latest",
    "@playwright/test": "latest",
    "@tailwindcss/postcss": "latest",
    "@types/node": "latest",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/three": "^0.187.0",
    "@webgpu/types": "^0.1.74",
    "eslint": "latest",
    "eslint-config-next": "^16.4.3",
    "prettier": "^3.9.6",
    "prisma": "^7.10.0",
    "sharp": "^0.35.4",
    "tailwindcss": "latest",
    "tsx": "latest",
    "typescript": "latest"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0",
    "mysql2": "^3.24.0",
    "decode-uri-component": "^0.5.1",
    "ws@^8.0.0": "^8.22.1"
  }
}
