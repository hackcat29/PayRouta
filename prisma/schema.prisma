model PlatformDispute {
 id String @id @default(cuid())
 attemptId String
 payment PlatformPayment @relation(fields: [attemptId], references: [attemptId], onDelete: NoAction, onUpdate: NoAction)
 orgId String
 org Organization @relation(fields: [orgId], references: [id], onDelete: NoAction, onUpdate: NoAction)
 environment String
 platformAccountId String
 platformAccount PlatformAccount @relation(fields: [platformAccountId], references: [id], onDelete: NoAction, onUpdate: NoAction)
 providerDisputeRef String
 asset String
 amountMinor Decimal @db.Decimal(50,0)
