  from              String?
  to                String
  reason            String
  actorId           String
  evidence          Json
  createdAt         DateTime        @default(now())

  @@index([merchantAccountId, createdAt])
}

model MerchantBalance {
  orgId       String
  environment String
  asset       String
  account     String
  balance     Decimal  @default(0) @db.Decimal(50, 0)
  updatedAt   DateTime @default(now())

  @@id([orgId, environment, asset, account])
}

model MerchantPlatformLink {
  id                String                       @id @default(cuid())
  orgId             String
  org               Organization                 @relation(fields: [orgId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  profile           MerchantKybProfile           @relation(fields: [orgId, profileVersion], references: [orgId, version], onDelete: NoAction, onUpdate: NoAction)
  integration       Integration?                 @relation(fields: [integrationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  detailsVersion    Int?
  details           MerchantVerificationDetails? @relation(fields: [orgId, detailsVersion], references: [orgId, version], onDelete: NoAction, onUpdate: NoAction)
  agreementId       String?
  agreement         MerchantAgreement?           @relation(fields: [agreementId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  platformAccountId String
  platformAccount   PlatformAccount              @relation(fields: [platformAccountId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  environment       String
  profileVersion    Int
  state             String                       @default("Queued")
  providerAccountId String?
  requirements      Json                         @default("[]")
  paymentsEnabled   Boolean                      @default(false)
  payoutsEnabled    Boolean                      @default(false)
  reason            String?
  integrationId     String?
  lastCheckedAt     DateTime?
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt
  payments          PlatformPayment[]
  payouts           Payout[]
  reconciliations   PlatformReconciliation[]

  @@unique([orgId, platformAccountId])
  @@unique([platformAccountId, providerAccountId])
  @@index([state, lastCheckedAt])
}

model PlatformPayment {
  attemptId           String               @id
  attempt             PaymentAttempt       @relation(fields: [attemptId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  intentId            String               @unique
  intent              PaymentIntent        @relation(fields: [intentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  orgId               String
  environment         String
  platformAccountId   String
  platformAccount     PlatformAccount      @relation(fields: [platformAccountId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  linkId              String
  link                MerchantPlatformLink @relation(fields: [linkId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  asset               String
  reference           String
  grossMinor          Decimal              @db.Decimal(50, 0)
  feeMinor            Decimal              @db.Decimal(50, 0)
  // Part of feeMinor that is the partner's standard fee passed on.
  partnerFeeMinor     Decimal              @default(0) @db.Decimal(50, 0)
  reserveMinor        Decimal?             @db.Decimal(50, 0)
  // Processing fee the provider took from the merchant's share.
  providerFeeMinor    Decimal              @default(0) @db.Decimal(50, 0)
  // Split settlement: the provider paid the merchant directly.
  settledDirectly     Boolean              @default(false)
  refunds             PlatformRefund[]
  disputes            PlatformDispute[]
  providerPaymentRef  String?
  providerTransferRef String?
  availableAt         DateTime?
  reserveReleaseAt    DateTime?
  state               String               @default("Pending")
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([orgId, environment, state])
}

model MerchantVerificationDetails {
  id               String                 @id @default(cuid())
  orgId            String
  org              Organization           @relation(fields: [orgId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  version          Int
  secretRef        String
  summary          Json
  fingerprint      String
  createdBy        String
  createdAt        DateTime               @default(now())
  merchantAccounts MerchantAccount[]
  platformLinks    MerchantPlatformLink[]

  @@unique([orgId, version])
}

model MerchantAgreement {
  id               String                 @id @default(cuid())
  orgId            String
  org              Organization           @relation(fields: [orgId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  version          String
  acceptedBy       String
  ip               String
  userAgent        String
  acceptedAt       DateTime               @default(now())
  merchantAccounts MerchantAccount[]
  platformLinks    MerchantPlatformLink[]

  @@index([orgId, acceptedAt])
}

// Payouts PayRouta initiates from a merchant's balance at a fund-holding
// platform account. A partial unique index on (orgId, environment,
// platformAccountId, asset, period) makes scheduled payouts idempotent.
model Payout {
  id                String               @id @default(cuid())
  orgId             String
  org               Organization         @relation(fields: [orgId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  environment       String
  platformAccountId String
  platformAccount   PlatformAccount      @relation(fields: [platformAccountId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  linkId            String
  link              MerchantPlatformLink @relation(fields: [linkId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  asset             String
  amountMinor       Decimal              @db.Decimal(50, 0)
  state             String               @default("Queued")
  providerPayoutRef String?
  failureCode       String?
  initiatedBy       String
  period            String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@unique([platformAccountId, providerPayoutRef])
  @@index([orgId, environment, createdAt])
  @@index([state, updatedAt])
}

model PlatformEvent {
  id                String          @id @default(cuid())
  platformAccountId String
  platformAccount   PlatformAccount @relation(fields: [platformAccountId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  eventId           String
  fingerprint       String
  type              String
  kind              String
  accountRef        String?
  objectRef         String?
  state             String          @default("Received")
  createdAt         DateTime        @default(now())

  @@unique([platformAccountId, eventId])
}

model PlatformRefund {
  id                  String          @id @default(cuid())
  attemptId           String
  payment             PlatformPayment @relation(fields: [attemptId], references: [attemptId], onDelete: NoAction, onUpdate: NoAction)
  orgId               String
  org                 Organization    @relation(fields: [orgId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  environment         String
  platformAccountId   String
  platformAccount     PlatformAccount @relation(fields: [platformAccountId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  asset               String
  amountMinor         Decimal         @db.Decimal(50, 0)
  fromAvailableMinor  Decimal         @db.Decimal(50, 0)
  fromReceivableMinor Decimal         @db.Decimal(50, 0)
  state               String          @default("Queued")
  providerRefundRef   String?
  failureCode         String?
  reason              String?
  initiatedBy         String
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@unique([platformAccountId, providerRefundRef])
  @@index([attemptId])
}

model PlatformDispute {
  id                  String          @id @default(cuid())
  attemptId           String
  payment             PlatformPayment @relation(fields: [attemptId], references: [attemptId], onDelete: NoAction, onUpdate: NoAction)
  orgId               String
  org                 Organization    @relation(fields: [orgId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  environment         String
  platformAccountId   String
  platformAccount     PlatformAccount @relation(fields: [platformAccountId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  providerDisputeRef  String
  asset               String
  amountMinor         Decimal         @db.Decimal(50, 0)
  feeMinor            Decimal         @default(0) @db.Decimal(50, 0)
  fromAvailableMinor  Decimal         @db.Decimal(50, 0)
  fromReserveMinor    Decimal         @db.Decimal(50, 0)
  fromReceivableMinor Decimal         @db.Decimal(50, 0)
  state               String
  fundsHeld           Boolean         @default(false)
  reason              String?
  evidenceDueBy       DateTime?
  evidence            Json?
  evidenceSubmittedAt DateTime?
  evidenceSubmittedBy String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@unique([platformAccountId, providerDisputeRef])
  @@index([orgId, environment, state])
}

model PlatformReconciliation {
  id                String               @id @default(cuid())
  linkId            String
  link              MerchantPlatformLink @relation(fields: [linkId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  orgId             String
  environment       String
  platformAccountId String
  platformAccount   PlatformAccount      @relation(fields: [platformAccountId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  asset             String
  day               String
  providerMinor     Decimal              @db.Decimal(50, 0)
  ledgerMinor       Decimal              @db.Decimal(50, 0)
  result            String
  createdAt         DateTime             @default(now())

  @@unique([linkId, asset, day])
}

// Payment providers can't sign themselves up. They ask for access through the
// public form, operations reviews the request, and an approval creates the
// provider organization and emails the contact an owner invitation.
model ProviderAccessRequest {
  id           String    @id @default(cuid())
  submissionId String    @unique
  state        String    @default("Pending")
  name         String
  email        String
  company      String
  website      String
  country      String
  providerType String
  methods      String
  markets      String
  message      String    @default("")
  reviewNote   String?
  reviewedBy   String?
  reviewedAt   DateTime?
  orgId        String?
  invitationId String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([state, createdAt])
  @@index([email])
}

// Cross-chain payment (lib/intents): the customer pays a crypto checkout from
// another chain or token. An intents network (NEAR Intents 1Click) quotes an
// exact-output swap that delivers the invoice amount to the merchant's
// receive address for this attempt; the customer sends `amountIn` of
// `originAsset` to `depositAddress`. PayRouta never holds the funds, and the
// payment is still confirmed only by the existing on-chain verification of
// the delivered transfer.
//
// With recipientType INTENTS the swap delivers into the merchant's NEAR
// Intents account instead (lib/providers/adapters/native/near-intents-deposit.ts);
// `details` keeps 1Click's swap details, whose intent hashes the adapter
// matches against intents.near events before confirming.
model CrossChainPayment {
  id                String   @id @default(cuid())
  intentId          String
  attemptId         String
  environment       String
  provider          String
  originAsset       String
  originChain       String
  originSymbol      String
  destinationAsset  String
  recipientType     String   @default("DESTINATION_CHAIN")
  // INTENTS: funded from the payer's NEAR Intents balance by a signed
  // transfer intent (an AI agent paying, lib/agents/checkout.ts); `payer`
  // is that account and `payload` the intent it signs.
  fundedBy          String   @default("ORIGIN_CHAIN")
  payer             String?
  payload           Json?
  intentHash        String?
  depositAddress    String   @unique
  depositMemo       String?
  amountIn          String
  amountInFormatted String
  amountOut         String
  refundTo          String
  deadline          DateTime
  quote             Json
  status            String   @default("PENDING_DEPOSIT")
  details           Json?
  checkedAt         DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([attemptId, createdAt])
}

// A key an AI agent uses to pay through the agent API (lib/agents), issued by
// a business with the limits it may spend within: a budget per period, a
// cap per payment, and optionally the merchants and paying account allowed.
model AgentKey {
  id              String    @id @default(cuid())
  orgId           String
  environment     String
  name            String
  prefix          String
  verifier        String    @unique
  // USD cents.
  budgetMinor     Decimal   @db.Decimal(30, 0)
  period          String
  perPaymentMinor Decimal   @db.Decimal(30, 0)
  // Merchant organization ids; empty allows any merchant.
  merchants       Json
  // The intents account it may pay from; null allows any.
  payer           String?
  createdBy       String
  lastUsedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())

  @@index([orgId, environment, createdAt])
}

// What an agent key has committed: reserved when a payment is prepared,
// spent once it is confirmed, released if it never completes.
model AgentSpend {
  id          String   @id @default(cuid())
  keyId       String
  intentId    String
  paymentId   String?
  amountMinor Decimal  @db.Decimal(30, 0)
  state       String   @default("Reserved")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([keyId, intentId])
  @@index([keyId, createdAt])
}

// A merchant-owned NEAR Intents account (lib/intents/account.ts). Crypto
// checkouts settle into it from any token on any chain, and the merchant pays
// out from it by signing intents in their own wallet. Ownership is proven by
// a signed challenge; PayRouta never holds the account's keys.
model IntentsAccount {
  id          String    @id @default(cuid())
  orgId       String
  environment String
  // A named NEAR account (nep413) or a lowercase EVM address (erc191).
  accountId   String
  standard    String
  publicKey   String?
  proof       Json
  createdBy   String
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([orgId, environment, createdAt])
}

// One-time ownership challenge for connecting an IntentsAccount.
model IntentsChallenge {
  id          String    @id @default(cuid())
  orgId       String
  environment String
  accountId   String
  standard    String
  message     String
  nonce       String
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
}

// A payout or refund from a merchant's NEAR Intents balance
// (lib/intents/payouts.ts): a 1Click quote funded from the intents account,
// signed in the merchant's wallet and submitted without gas.
model IntentsPayout {
  id                 String    @id @default(cuid())
  orgId              String
  environment        String
  accountId          String
  // payout | refund (of the payment `intentId`)
  purpose            String
  intentId           String?
  originAsset        String
  destinationAsset   String
  destinationChain   String
  destinationSymbol  String
  recipient          String
  amountIn           String
  amountInFormatted  String
  amountOutFormatted String
  depositAddress     String    @unique
  quote              Json
  payload            Json
  intentHash         String?
  status             String    @default("AWAITING_SIGNATURE")
  details            Json?
  note               String?
  createdBy          String
  checkedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([orgId, environment, createdAt])
  @@index([intentId])
}

// Shopify payments app (lib/integrations/shopify, docs/shopify.md). One row
// per installed shop. The offline access token lives in the secret vault.
model ShopifyShop {
  id             String    @id @default(cuid())
  shop           String    @unique
  orgId          String?
  environment    String    @default("sandbox")
  accessTokenRef String
  scopes         String
  // Fiat methods offered from this shop, and crypto options for USD shops.
  methods        Json
  cryptoOptions  Json
  ready          Boolean   @default(false)
  installedAt    DateTime  @default(now())
  uninstalledAt  DateTime?
  updatedAt      DateTime  @updatedAt
}

// A Shopify offsite payment session and the PayRouta universal checkout it
// opened. `id` is Shopify's idempotency key for the session.
model ShopifyPaymentSession {
  id            String    @id
  gid           String    @unique
  shop          String
  checkoutGroup String    @unique
  amount        String
  currency      String
  test          Boolean
  cancelUrl     String
  // Key of the universal checkout (lib/payments/universal.ts); the checkout
  // link itself stays in the secret vault.
  checkoutKey   String
  state         String    @default("Pending")
  nextActionUrl String?
  resolvedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([shop, createdAt])
}

model ShopifyRefundSession {
  id         String   @id
  gid        String   @unique
  shop       String
  paymentId  String
  amount     String
  currency   String
  state      String   @default("Pending")
  refundId   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// Shopify with a manual payment method (lib/integrations/shopify-lite.ts): a
// separate app with read_orders and write_orders. `gateway` is the manual
// payment method's name as orders list it.
model ShopifyLiteShop {
  id               String    @id @default(cuid())
  shop             String    @unique
  orgId            String
  environment      String
  accessTokenRef   String
  scopes           String
  gateway          String
  // Hours an unpaid order stays open; 0 never cancels.
  cancelAfterHours Int
  methods          Json
  cryptoOptions    Json
  installedAt      DateTime  @default(now())
  uninstalledAt    DateTime?
  updatedAt        DateTime  @updatedAt
}

// An order placed with the PayRouta manual payment method. `amount` is what
// was outstanding, in the order's presentment currency, when first seen.
model ShopifyLiteOrder {
  id            String    @id @default(cuid())
  shop          String
  orderId       String
  name          String
  amount        String
  currency      String
  test          Boolean
  statusUrl     String
  placedAt      DateTime
  checkoutKey   String?
  checkoutGroup String?   @unique
  // Random; PayRouta checkout returns the buyer with it.
  returnToken   String?   @unique
  state         String    @default("Pending")
  paidAt        DateTime?
  cancelledAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([shop, orderId])
}

// Payment link (lib/merchant/payment-links.ts): a shareable URL for merchants
// with no website or store. Each visit that presses Pay opens a fresh
// universal checkout for the link's amount; nothing is created by previews.
model PaymentLink {
  id          String   @id @default(cuid())
  orgId       String
  environment String
  slug        String   @unique
  title       String
  description String?
  amount      String
  currency    String
  // Fiat methods offered, and whether stablecoins are offered (USD links).
  methods     Json
  crypto      Boolean  @default(false)
  // Where most customers are; a visitor's own country is used when known.
  country     String
  active      Boolean  @default(true)
  checkouts   Int      @default(0)
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([orgId, environment, createdAt])
}
