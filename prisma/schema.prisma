 acceptedAt DateTime @default(now())
 merchantAccounts MerchantAccount[]
 platformLinks MerchantPlatformLink[]
 @@index([orgId, acceptedAt])
}
// Payouts PayRouta initiates from a merchant's balance at a fund-holding
// platform account. A partial unique index on (orgId, environment,
// platformAccountId, asset, period) makes scheduled payouts idempotent.
model Payout {
 id String @id @default(cuid())
 orgId String
 org Organization @relation(fields: [orgId], references: [id], onDelete: NoAction, onUpdate: NoAction)
 environment String
 platformAccountId String
 platformAccount PlatformAccount @relation(fields: [platformAccountId], references: [id], onDelete: NoAction, onUpdate: NoAction)
 linkId String
 link MerchantPlatformLink @relation(fields: [linkId], references: [id], onDelete: NoAction, onUpdate: NoAction)
 asset String
 amountMinor Decimal @db.Decimal(50,0)
 state String @default("Queued")
 providerPayoutRef String?
 failureCode String?
 initiatedBy String
 period String?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@unique([platformAccountId, providerPayoutRef])
 @@index([orgId, environment, createdAt])
 @@index([state, updatedAt])
}
