# Trusted HTTPS production origin. Leave blank for noindex previews. Build-time setting.
SITE_URL=
# Server-only HTTPS destination. Must accept JSON and honor Idempotency-Key.
CONTACT_WEBHOOK_URL=
# Server-only optional bearer token. Never prefix with NEXT_PUBLIC_.
CONTACT_WEBHOOK_TOKEN=
# Optional verified public fallback email; exposed on contact page if configured.
CONTACT_EMAIL=
# Where new provider access requests are announced (defaults to CONTACT_EMAIL).
PROVIDER_REQUESTS_EMAIL=

# Provider portal (server runtime required; never NEXT_PUBLIC_)
DATABASE_URL=postgresql://payrouta:CHANGE_ME@127.0.0.1:55432/payrouta
BETTER_AUTH_URL=http://127.0.0.1:3000
# Generate a cryptographically random secret. portal:env creates one locally.
BETTER_AUTH_SECRET=
# local only works with a loopback BETTER_AUTH_URL. Use production for real deployments.
# PAYMENT_FEE_SCHEDULES is an operator-approved JSON array. USD defaults to 25/10 bps capped at 200/100 cents.
# Non-USD and crypto require explicit caps and, for fiat conversion, an expiring evidenced valuation.
# See docs/BILLING.md; do not assume stablecoin parity or insert unapproved FX rates.
PAYMENT_FEE_SCHEDULES=[]

PORTAL_MODE=production
# Development vault key: absolute path OUTSIDE repository, 32 random bytes, permission 0600.
LOCAL_VAULT_KEY_FILE=
LOCAL_DATA_DIR=.local/portal
EVIDENCE_RETENTION_DAYS=90
# Private document storage: Cloudflare R2 (or any S3-compatible store).
# R2: S3_ENDPOINT=https://<account id>.r2.cloudflarestorage.com, S3_REGION=auto,
# and an R2 API token's access key pair below (Object Read & Write, this bucket only).
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# ---- Production services (all fail closed when unset; see docs/PRODUCTION.md) ----
# Secret store master keys: "keyId:base64(32 bytes)[,keyId:…]". Kept outside the
# database. Generate with: openssl rand -base64 32. Back up offline.
SECRET_MASTER_KEYS=
# Optional; defaults to the first key. Rotate with npm run secrets:rotate.
SECRET_ACTIVE_KEY_ID=
# ---- Sign-in ----
# Google sign-in (optional; the button only appears when both are set). Create
# an OAuth client at console.cloud.google.com → APIs & Services → Credentials,
# type "Web application", redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Passkeys use BETTER_AUTH_URL's hostname as the relying-party ID, so they
# only work on a real domain (payrouta.com), not on 127.0.0.1.
# Company SSO (SAML/OIDC) is set up by each merchant under Settings; no keys here.

# ---- Email (Resend) ----
# Resend sends all mail: sign-up verification, password resets, invitations
# and marketing. Keep the real key in .env only; never commit it.
RESEND_API_KEY=
# Sender on a domain verified in Resend (Domains -> add payrouta.com, then the
# SPF, DKIM and DMARC records it shows).
RESEND_FROM_EMAIL=PayRouta <updates@payrouta.com>
RESEND_REPLY_TO=support@payrouta.com
# Optional segment that confirmed marketing subscribers are added to.
# RESEND_AUDIENCE_ID is still read for older setups (Audiences became Segments).
RESEND_SEGMENT_ID=
# Signing secret (whsec_...) for the webhook pointing at /api/webhooks/resend.
# Without it the webhook endpoint rejects every request.
RESEND_WEBHOOK_SECRET=
# Optional fallback if a Resend send fails: smtps://user:pass@host:465 or smtp://user:pass@host:587.
SMTP_URL=
MAIL_FROM=
# Optional: lets an external scheduler call /api/marketing/cron with
# "Authorization: Bearer <CRON_SECRET>" (32+ characters). The worker already sends drips.
CRON_SECRET=
# ClamAV daemon for evidence malware scanning (localhost only).
CLAMD_HOST=
CLAMD_PORT=3310
# "enabled" lets merchants use simulated providers in the sandbox environment
# on this deployment (then run npm run sandbox:providers once).
HOSTED_SANDBOX=

# Optional normalized availability evidence lifetimes (1000–300000 ms).
# Conservative defaults; shortening below the worker cadence can yield UNKNOWN.
AVAILABILITY_HEALTH_TTL_MS=60000
AVAILABILITY_AVAILABILITY_TTL_MS=60000
AVAILABILITY_CAPACITY_TTL_MS=30000
AVAILABILITY_MAINTENANCE_TTL_MS=300000
AVAILABILITY_RESTRICTION_TTL_MS=300000

# Optional local payment receiver fault injection (fictional loopback receiver only).
PAYMENT_RECEIVER_FAIL_FIRST=0

# Secret-manager reference only; never put an Alchemy key in browser/public variables.
ALCHEMY_RPC_KEY_REF=

# auto: Alchemy with verified public fallback; public: fixed public endpoints; alchemy: no fallback.
PAYMENT_RPC_MODE=auto
## Crypto USD quotes (store API keys in the encrypted secret store)
COINGECKO_API_KEY_REF=
COINGECKO_API_PLAN=demo
# Pay from another chain or token (docs/cross-chain.md): NEAR Intents 1Click.
# Off unless set to near-intents; production checkouts only. The partner API
# key is optional but avoids 1Click's unauthenticated fee; store it in the
# secret vault and put its reference here.
CROSS_CHAIN_PAYMENTS=
ONECLICK_API_KEY_REF=
# Shopify payments app (integrations/shopify, docs/shopify.md). Secrets are
# vault references. SHOPIFY_MTLS_PROXY_SECRET is the header nginx adds after
# verifying Shopify's client certificate (deploy/nginx.conf).
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET_REF=
SHOPIFY_API_VERSION=2026-10
SHOPIFY_MTLS_PROXY_SECRET_REF=

# Provider Test Credentials (Sandbox testing via npm run treasury:sandbox or native adapters)
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_WEBHOOK_SECRET=
STRIPE_TEST_CONNECT_WEBHOOK_SECRET=
PAYSTACK_TEST_SECRET_KEY=
PAYSTACK_TEST_PUBLIC_KEY=
FLUTTERWAVE_TEST_SECRET_KEY=
FLUTTERWAVE_TEST_PUBLIC_KEY=
FLUTTERWAVE_WEBHOOK_HASH=
MONNIFY_TEST_SECRET_KEY=
MONNIFY_TEST_API_KEY=
DLOCAL_SANDBOX_LOGIN=
DLOCAL_SANDBOX_TRANS_KEY=
DLOCAL_SANDBOX_SECRET_KEY=
DLOCAL_PLATFORM_TYPE=PAYROUTA
TINK_CLIENT_ID=
TINK_CLIENT_SECRET=
TINK_MERCHANTS_PATH=/merchants
TINK_REDIRECT_URI=
XENDIT_TEST_SECRET_KEY=
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=
