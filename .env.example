# Trusted HTTPS production origin. Leave blank for noindex previews. Build-time setting.
SITE_URL=
# Server-only HTTPS destination. Must accept JSON and honor Idempotency-Key.
CONTACT_WEBHOOK_URL=
# Server-only optional bearer token. Never prefix with NEXT_PUBLIC_.
CONTACT_WEBHOOK_TOKEN=
# Optional verified public fallback email; exposed on contact page if configured.
CONTACT_EMAIL=

# Provider portal (server runtime required; never NEXT_PUBLIC_)
DATABASE_URL=postgresql://payrouta:CHANGE_ME@127.0.0.1:55432/payrouta
BETTER_AUTH_URL=http://127.0.0.1:3000
# Generate a cryptographically random secret. portal:env creates one locally.
BETTER_AUTH_SECRET=
# local only works with a loopback BETTER_AUTH_URL. Use production for real deployments.
PORTAL_MODE=production
# Development vault key: absolute path OUTSIDE repository, 32 random bytes, permission 0600.
LOCAL_VAULT_KEY_FILE=
LOCAL_DATA_DIR=.local/portal
EVIDENCE_RETENTION_DAYS=90
# Private S3 production storage uses AWS SDK default credential chain.
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
# Production scanner, provider checks, registry, mail and managed secrets need adapters.
# They are intentionally fail-closed; see docs/PROVIDER-PORTAL.md.

# Optional normalized availability evidence lifetimes (1000–300000 ms).
# Conservative defaults; shortening below the worker cadence can yield UNKNOWN.
AVAILABILITY_HEALTH_TTL_MS=60000
AVAILABILITY_AVAILABILITY_TTL_MS=60000
AVAILABILITY_CAPACITY_TTL_MS=30000
AVAILABILITY_MAINTENANCE_TTL_MS=300000
AVAILABILITY_RESTRICTION_TTL_MS=300000

# Optional local payment receiver fault injection (fictional loopback receiver only).
PAYMENT_RECEIVER_FAIL_FIRST=0
